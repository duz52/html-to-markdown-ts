{
  "name": "html-to-markdown-ts",
  "version": "0.1.1",
  "description": "Convert HTML to Markdown. A TypeScript port of the Go library github.com/JohannesKaufmann/html-to-markdown, using parse5 for parsing.",
  "keywords": [
    "html",
    "markdown",
    "commonmark",
    "converter",
    "parse5"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duz52/html-to-markdown-ts.git"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/duz52"
  },
  "license": "MIT",
  "author": "Jerry Ho",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "parse5": "^7.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json && node scripts/write-dist-pkg.mjs esm",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-dist-pkg.mjs cjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "playground": "python3 -m http.server -d playground 8000"
  }
}
